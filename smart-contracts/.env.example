# GridProof contract deployment configuration.
#
# Copy to smart-contracts/.env and fill in the values for the network you are
# deploying to. Pull RPC URLs, chain IDs, and explorer URLs from the official
# BOT Chain docs; never guess them or hardcode them in Solidity.
#
# Load into the shell before running forge:
#   set -a && . ./.env && set +a

# --- Network (used on the forge command line, not read by Deploy.s.sol) ---
# Official BOT Chain settings verified against each RPC with eth_chainId.
BOTCHAIN_RPC_URL_TESTNET=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID_TESTNET=968
BOTCHAIN_EXPLORER_URL_TESTNET=https://scan.bohr.life
BOTCHAIN_RPC_URL_MAINNET=https://rpc.botchain.ai
BOTCHAIN_CHAIN_ID_MAINNET=677
BOTCHAIN_EXPLORER_URL_MAINNET=https://scan.botchain.ai

# Select exactly one network for the current command. Mainnet example:
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_CHAIN_ID=677
BOTCHAIN_EXPLORER_API_URL=
BOTCHAIN_EXPLORER_URL=https://scan.botchain.ai
# Only needed if the BOT Chain explorer requires a key for verification.
BOTCHAIN_EXPLORER_API_KEY=

# Deployer/broadcaster key. Keep this local; never commit a populated value.
# Prefer --ledger or --account <keystore> over a raw key for mainnet.
DEPLOYER_PRIVATE_KEY=

# --- Required by Deploy.s.sol ---
# Names the manifest file: smart-contracts/deployments/<GRIDPROOF_NETWORK>.json
GRIDPROOF_NETWORK=botchainMainnet
# Holds DEFAULT_ADMIN_ROLE on all three contracts. Use a multisig for mainnet.
GRIDPROOF_ADMIN_ADDRESS=
# Holds RELAYER_ROLE only. Must differ from the admin address: the API relayer is
# a hot wallet and must never be able to change policy or grant roles.
GRIDPROOF_RELAYER_ADDRESS=

# --- Optional policy params (defaults shown; all values in seconds or wei) ---
# Hourly epochs, matching EPOCH_DURATION_MS in the API pipeline service.
GRIDPROOF_EPOCH_DURATION_SECONDS=3600
# Per-call slash ceiling enforced by ReputationEscrow. 0.5 ether.
GRIDPROOF_SLASH_POLICY_CAP=500000000000000000
# Stake floor a provider must keep while active. 0.1 ether.
GRIDPROOF_MINIMUM_STAKE=100000000000000000
# Delay between withdraw requests for active providers. 3 days.
GRIDPROOF_WITHDRAW_COOLDOWN_SECONDS=259200
# Comma-separated feeder zone keys to seed into the NodeRegistry allowlist.
# Existing 0x + 64-hex bytes32 keys are preserved exactly; human-readable IDs
# are keccak256-hashed. Use the same zone_key values stored by the API database.
# Only applied when the broadcasting account is GRIDPROOF_ADMIN_ADDRESS; with a
# multisig admin, call NodeRegistry.addZone from the multisig instead.
GRIDPROOF_ZONE_IDS="0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb,0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
