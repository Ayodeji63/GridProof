VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional demo/reviewer JWT. The API verifies this with SUPABASE_JWT_SECRET
# or GRIDPROOF_DEV_JWT_SECRET. Prefer real Supabase Auth for deployed demos.
VITE_DEMO_AUTH_TOKEN=

# Optional Sentry capture. Leave blank for local/offline demos.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=gridproof-web@0.1.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0
