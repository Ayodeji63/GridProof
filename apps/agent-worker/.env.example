NODE_ENV=development
LOG_LEVEL=info
PORT=4101
DATABASE_URL=postgres://gridproof:gridproof@localhost:5432/gridproof
REDIS_URL=redis://localhost:6379

# FreeLLMAPI router root. Do NOT include /v1 -- the client appends
# /v1/chat/completions itself (packages/ai/src/llm-client.ts), so a /v1 here
# produces /v1/v1/chat/completions and a 404. 3001 is the router's default port.
LLM_BASE_URL=http://localhost:3001

# The single unified key issued by the FreeLLMAPI dashboard (not a provider key).
LLM_API_KEY=

# Must be concrete model IDs from the router's catalog. The code's defaults
# ("fast-free-model" / "strong-free-model") are placeholders that match nothing.
# List what your router actually serves:
#   curl -s http://localhost:3001/v1/models -H "Authorization: Bearer $LLM_API_KEY" | jq -r '.data[].id'
# Pin explicit IDs rather than an "auto" profile so demo runs are reproducible.
LLM_ANALYSIS_MODEL=
LLM_VERIFICATION_MODEL=

# Per-request abort budget. FreeLLMAPI fails over between providers, which adds
# latency on top of the model's own; 8000 (the code default) is tight for that.
LLM_TIMEOUT_MS=20000
