NODE_ENV=development
PORT=4000
API_VERSION=0.1.0
# Comma-separated frontend origins allowed by browser CORS.
# Required in production. CORS_ORIGIN is accepted as a legacy single-origin alias.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://gridproof:gridproof@localhost:5432/gridproof
REDIS_URL=redis://localhost:6379
GRIDPROOF_EVIDENCE_MODE=hybrid
INGEST_RATE_LIMIT_MAX=60
INGEST_RATE_LIMIT_WINDOW_MS=60000
REDIS_RATE_LIMIT_TIMEOUT_MS=500
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Optional local override for non-production JWT verification.
# If unset outside production, the API uses a built-in dev-only secret for tests and local demos.
GRIDPROOF_DEV_JWT_SECRET=gridproof-local-dev-jwt-secret
GRIDPROOF_DEMO_ENABLED=true
# Enables judge-authorized synthetic proof publication through the backend relayer.
# Leave false except during a supervised demo because writes are permanent and spend relayer gas.
GRIDPROOF_DEMO_ALLOW_CHAIN_WRITE=false
RELAYER_PRIVATE_KEY=
BOTCHAIN_RPC_URL=
BOTCHAIN_EXPLORER_BASE_URL=
BOTCHAIN_NODE_REGISTRY_ADDRESS=
BOTCHAIN_UPTIME_ATTESTATION_ADDRESS=
BOTCHAIN_REPUTATION_ESCROW_ADDRESS=
# Required in production. Local demos may leave this as a dev-only value.
TELEMETRY_HMAC_SECRET=dev-only-change-me
# Required in production for POST /api/v1/ingest/whatsapp-webhook.
# Verifies the X-Hub-Signature-256 HMAC sent by the WhatsApp/Twilio adapter.
WHATSAPP_WEBHOOK_SECRET=

# Optional Sentry capture. Leave blank for local/offline demos.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=gridproof-api@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0
