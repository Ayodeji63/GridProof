{
  "name": "gridproof",
  "version": "0.1.0",
  "private": true,
  "description": "GridProof verified grid power-uptime DePIN network monorepo.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "pnpm --filter @gridproof/e2e test",
    "lint": "turbo run lint && pnpm scripts:typecheck",
    "typecheck": "turbo run typecheck",
    "scripts:typecheck": "tsc -p scripts/tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo-data.ts",
    "deployment:contracts": "tsx scripts/verify-contract-manifest.ts",
    "deployment:data": "tsx scripts/verify-data-services.ts",
    "deployment:evidence": "tsx scripts/verify-demo-evidence.ts",
    "deployment:verify": "tsx scripts/verify-deployment.ts",
    "contracts:test": "forge test --root smart-contracts",
    "foundry:test": "forge test --root smart-contracts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.11",
    "turbo": "^2.6.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "^0.6.0",
      "lodash": "^4.18.1",
      "serialize-javascript": "^7.1.0",
      "tmp": "^0.2.7",
      "undici": "^8.10.0",
      "vite": "^8.2.1",
      "ws": "^8.21.3"
    }
  }
}
